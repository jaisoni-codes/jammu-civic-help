# Bharosa Jammu Environment Configuration
ENV=development
DEBUG=true

# Database (PostgreSQL with PostGIS or SQLite fallback)
DATABASE_URL=sqlite:///./bharosa.db
# PostgreSQL with PostGIS:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/bharosa

# AI Settings
MOCK_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Channel selection: console | telegram | whatsapp
CHANNEL=console

# Telegram Bot (Optional for live Telegram mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# WhatsApp Cloud API (Optional for live WhatsApp mode)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=bharosa_secret_token_2026

# JWT Auth
JWT_SECRET=bharosa_jammu_jwt_secret_key_change_in_prod_7788
JWT_ALGORITHM=HS256

# Clock Demo Offset
DEMO_OFFSET_HOURS=0.0

BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
